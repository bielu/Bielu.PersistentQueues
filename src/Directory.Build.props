<Project>

    <Import Project="../version.props"/>

    <PropertyGroup>
      <Title>$(MSBuildProjectName)</Title>
      <AssemblyName>$(MSBuildProjectName)</AssemblyName>
      <AssemblyVersion>$(Version)</AssemblyVersion>
      <RunSettingsFilePath>$(MSBuildThisFileDirectory)../coverlet.runsettings</RunSettingsFilePath>
    </PropertyGroup>

    <PropertyGroup>
        <Authors>bielu;Corey Kaylor</Authors>
        <PackageOutputPath>$(MSBuildProjectDirectory)/../../dist</PackageOutputPath>
        <PackageReadmeFile>readme.md</PackageReadmeFile>
        <PackageIcon>icon.png</PackageIcon>
        <!-- Applies to every shipping package, not just the core one: a published NuGet
             version is immutable, so a package without a license can never be corrected. -->
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <Copyright>Copyright (c) 2017 LightningQueues, (c) 2026 bielu</Copyright>
        <RepositoryUrl>https://github.com/bielu/Bielu.PersistentQueues</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageProjectUrl>https://github.com/bielu/Bielu.PersistentQueues</PackageProjectUrl>
    </PropertyGroup>

    <PropertyGroup>
        <!-- Ship the XML docs that already exist in source so consumers get IntelliSense.
             CS1591 is suppressed rather than fixed: it would otherwise warn for every public
             member that has no doc comment yet, which is not a release blocker. -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
    </PropertyGroup>

    <PropertyGroup>
        <!-- Symbols + Source Link, so consumers can step into the packages. The SourceLink
             GitHub provider ships in the .NET SDK, so no PackageReference is needed. -->
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
    </PropertyGroup>

    <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
        <!-- Normalizes embedded paths so CI-produced packages are byte-reproducible. -->
        <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    </PropertyGroup>

    <ItemGroup>
        <None Include="$(MSBuildThisFileDirectory)../readme.md" Pack="true" PackagePath="/" />
        <None Include="$(MSBuildThisFileDirectory)../icon.png" Pack="true" PackagePath="/" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Bielu.StaticCode.Analyzers">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <!--
      Public API tracking is opt-in per project: adding PublicAPI.Shipped.txt and PublicAPI.Unshipped.txt
      next to the csproj turns it on. A public member missing from those files (RS0016), or listed there
      but gone from the code (RS0017), then fails the build instead of only warning, so a change to the
      public surface cannot merge unrecorded. scripts/ship-public-api.mjs moves Unshipped to Shipped
      when a stable version is released.
    -->
    <PropertyGroup Condition="Exists('$(MSBuildProjectDirectory)/PublicAPI.Unshipped.txt')">
        <WarningsAsErrors>$(WarningsAsErrors);RS0016;RS0017</WarningsAsErrors>
        <!-- RS0026/RS0027 (overloads with optional parameters) flag APIs that already shipped in 1.0.0
             (Message.Create, AddLmdbStorage, AddZoneTreeStorage, StoreWithLmdb, UsePartitioning);
             reshaping them is a breaking change, so they are not actionable before the next major. -->
        <NoWarn>$(NoWarn);RS0026;RS0027</NoWarn>
    </PropertyGroup>
    <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)/PublicAPI.Unshipped.txt')">
        <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

</Project>
